# VINsight settings. Copy to .env and fill in. Everything here is free to run.

# --- Required: one free Groq key runs the whole demo, voice included ---
# Get one at https://console.groq.com/keys
# Used for: the voice call (Whisper speech-to-text, GPT-OSS for Sam and the note-taker),
# and the GPT-OSS model in the model picker.
GROQ_API_KEY=

# --- Optional: Gemini, as a backup and an extra choice in the model picker ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Advisor call voice ---
# Default: Groq's Orpheus voice (needs the Groq key). Accept its terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# If it's unavailable or over the free-tier limit, the call switches to Kokoro, an open voice
# model that runs in the visitor's browser (free, no key).

# --- Optional overrides (defaults shown) ---
# VINSIGHT_PROVIDER=gpt-oss-120b      # gpt-oss-120b | gpt-oss-20b | qwen3.8-27b | gemini | claude
# VINSIGHT_BACKUP_PROVIDER=gemini     # takes over if the active model fails; "none" to disable
# GEMINI_MODELS=["gemini-3.5-flash","gemini-3.8-flash"]
# GROQ_TTS_VOICE=daniel            # austin | daniel | troy (male) · autumn | diana | hannah

# --- Optional: Claude instead ---
# ANTHROPIC_API_KEY=
# VINSIGHT_MODEL=claude-opus-5-5
