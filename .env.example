# VINsight settings. Copy to .env and fill in. Everything here is free to run.

# --- Required: one free Groq key runs the whole demo, voice included ---
# Get one at https://console.groq.com/keys
# Used for: the voice call (Whisper speech-to-text, GPT-OSS for Sam and the note-taker),
# and the GPT-OSS model in the model picker.
GROQ_API_KEY=

# --- Optional: Gemini as the default text model ---
# Get one at https://aistudio.google.com/apikey
# Without it, GPT-OSS on Groq handles text chat too.
GEMINI_API_KEY=

# --- Optional: natural voice for the advisor call ---
# No key needed: accept the Orpheus model terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Until then the call uses your browser's built-in voice.

# --- Optional overrides (defaults shown) ---
# VINSIGHT_PROVIDER=gemini            # gemini | groq | claude: starting text model
# VINSIGHT_BACKUP_PROVIDER=groq       # takes over if the active model fails; "none" to disable
# GEMINI_MODELS=["gemini-3.5-flash","gemini-3.8-flash"]
# GROQ_MODELS=["openai/gpt-oss-120b"]
# GROQ_TTS_VOICE=tara

# --- Optional: Claude instead ---
# ANTHROPIC_API_KEY=
# VINSIGHT_MODEL=claude-opus-5-5
